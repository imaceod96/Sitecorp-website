# App configuration
# URL directa a la que redirige el botón "Iniciar sesión" sin pasar por el modal
# (ej. http://localhost:8080/login, tu URL de Dev Tunnel en VS Code, o https://app.sitecorp.cu/login)
VITE_SITECORP_LOGIN_URL=http://localhost:8080/login

# URL base del servidor de la aplicación Sitecorp
VITE_SITECORP_APP_URL=https://app.sitecorp.cu

# Correo de contacto y recepción de solicitudes de demostración
VITE_SITECORP_CONTACT_EMAIL=imaceod96+sitecorp@gmail.com


